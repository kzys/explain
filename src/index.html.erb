<!DOCTYPE html>
<html>
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="style.css">
    <link rel="alternate" type="application/atom+xml" href="atom.xml">
    <title>explain / 説明</title>
  </head>
  <body>
    <%= include 'header.html.erb' %>
    <main id="index">
      <% pages = self.find('src/**/*.md').sort{|a, b| b.mtime <=> a.mtime } %>
      <% max_size = pages.map(&:size).max %>
      <% pages.each do |page| %>
      <article>
	<h2><a href="<%= page.url %>"><%= page.title %></a></h2>
	<% if page.changes && page.changes.length > 0 %>
	  <div class="page-metadata">
	    <ul class="changes-items">
	      <% reversed = page.changes.reverse %>
	      <% reversed.each_with_index do |timestamp, index| %>
		<li>
		  <time datetime="<%= timestamp.iso8601 %>"><%= timestamp.strftime('%Y-%m-%d %H:%M') %></time><% if index == 0 %> - created<% else %> - updated<% end %>
		</li>
	      <% end %>
	    </ul>
	  </div>
	<% end %>
	<div class="meta">
	  <div><%= if page.url =~ %r{^ja/} then '日本語' else 'English' end %></div>
	  <div class="bar" style="width:<%= [(page.size.to_f / max_size * 100).round(1), 1].max %>%">&nbsp;</div>
	</div>
      </article>
      <% end %>
    </main>
    <%= include 'footer.html.erb' %>
  </body>
</html>
