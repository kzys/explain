<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="<%= asset_path('style.css') %>">
    <link rel="alternate" type="application/atom+xml" href="atom.xml">
    <title>explain / 説明</title>
  </head>
  <body>
    <%= include 'header.html.erb' %>
    <main id="index">
      <% pages = self.find('src/**/*.md').sort{|a, b| b.mtime <=> a.mtime } %>
      <% max_size = pages.map(&:size).max %>
      <% ja_count = pages.count(&:ja?) %>
      <% en_count = pages.count(&:en?) %>
      <% ratio_series = self.language_ratio_series(en_count, ja_count) %>
      <% ratio_chart = self.language_ratio_svg(ratio_series) %>
      <% latest_ratio = ratio_series.last %>

      <div class="language-ratio">
        <div class="ratio-summary">
          <span class="lang-tag lang-en">English: <%= latest_ratio.en_count %> posts (<%= latest_ratio.en_percent %>%)</span>
          <span class="lang-tag lang-ja">日本語: <%= latest_ratio.ja_count %> posts (<%= latest_ratio.ja_percent %>%)</span>
        </div>
        <% if ratio_chart %>
          <svg class="ratio-trend" viewBox="0 0 <%= ratio_chart[:width] %> <%= ratio_chart[:height] %>" preserveAspectRatio="none" role="img" aria-label="Share of English vs. Japanese posts, <%= ratio_series.first.date.strftime('%Y-%m') %> to today, ending at <%= latest_ratio.en_percent %>% English">
            <path class="ratio-area-ja" d="<%= ratio_chart[:ja_path] %>"></path>
            <path class="ratio-area-en" d="<%= ratio_chart[:en_path] %>"></path>
          </svg>
          <div class="ratio-trend-labels">
            <span><%= ratio_series.first.date.year %></span>
            <span>now</span>
          </div>
        <% end %>
      </div>
      <% grouped = self.group_by_content(pages) %>
      <% grouped.each do |base_path, group_pages| %>
      <article>
	<% if group_pages.length > 1 %>
	  <% group_pages.each do |page| %>
	    <div class="language-section">
	      <a href="<%= page.url %>" class="article-link">
		<h2><% if page.directory %><span class="directory-tag"><%= page.directory %></span> <% end %><span><%= page.title %></span></h2>
		<% if page.headlines.any? %>
		  <ul class="headlines">
		    <% page.headlines.each do |headline| %>
		      <li class="headline-level-<%= headline[:level] %>"><%= headline[:text] %></li>
		    <% end %>
		  </ul>
		<% end %>
		<% if page.changes && page.changes.length > 0 %>
		  <div class="page-metadata">
		    <ul class="changes-items">
		      <% reversed = page.changes.reverse.uniq { |t| t.to_date } %>
		      <% reversed.each_with_index do |timestamp, index| %>
			<li>
			  <time datetime="<%= timestamp.strftime('%Y-%m-%d') %>"><%= timestamp.strftime('%Y-%m-%d') %></time><% if index == 0 %> - created<% else %> - updated<% end %>
			</li>
		      <% end %>
		    </ul>
		  </div>
		<% end %>
		<div class="meta">
		  <div class="bar <%= page.bar_class %>" style="width:<%= [(page.size.to_f / max_size * 100).round(1), 1].max %>%"><%= page.language_name %> · <%= page.human_size %></div>
		</div>
	      </a>
	    </div>
	  <% end %>
	<% else %>
	  <a href="<%= group_pages.first.url %>" class="article-link">
	    <h2><% if group_pages.first.directory %><span class="directory-tag"><%= group_pages.first.directory %></span> <% end %><span><%= group_pages.first.title %></span></h2>
	    <% page = group_pages.first %>
	    <% if page.headlines.any? %>
	      <ul class="headlines">
		<% page.headlines.each do |headline| %>
		  <li class="headline-level-<%= headline[:level] %>"><%= headline[:text] %></li>
		<% end %>
	      </ul>
	    <% end %>
	    <% if page.changes && page.changes.length > 0 %>
	      <div class="page-metadata">
		<ul class="changes-items">
		  <% reversed = page.changes.reverse.uniq { |t| t.to_date } %>
		  <% reversed.each_with_index do |timestamp, index| %>
		    <li>
		      <time datetime="<%= timestamp.strftime('%Y-%m-%d') %>"><%= timestamp.strftime('%Y-%m-%d') %></time><% if index == 0 %> - created<% else %> - updated<% end %>
		    </li>
		  <% end %>
		</ul>
	      </div>
	    <% end %>
	    <div class="meta">
	      <div class="bar <%= page.bar_class %>" style="width:<%= [(page.size.to_f / max_size * 100).round(1), 1].max %>%"><%= page.language_name %> · <%= page.human_size %></div>
	    </div>
	  </a>
	<% end %>
      </article>
      <% end %>
    </main>
    <%= include 'footer.html.erb' %>
  </body>
</html>
