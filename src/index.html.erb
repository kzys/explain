<!DOCTYPE html>
<html>
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="style.css">
    <link rel="alternate" type="application/atom+xml" href="atom.xml">
    <title>explain / 説明</title>
  </head>
  <body>
    <%= include 'header.html.erb' %>
    <main id="index">
      <% self.find('src/*/*.md').each do |page| %>
      <article>
	<h2><a href="<%= page.url %>"><%= page.title %></a></h2>
	<div class="meta">
	  <div>
	    Created: <%= page.ctime&.strftime('%Y-%m-%d') %>
	    <% if page.mtime > page.ctime %>
	    / Modified: <%= page.mtime&.strftime('%Y-%m-%d') %>
	    <% end %>
	  </div>
	  <div><%= if page.url =~ %r{^ja/} then '日本語' else 'English' end %></div>
	  <div class="bar" style="width:<%= [1, page.size/10].max %>px">&nbsp;</div>
	</div>
      </article>
      <% end %>
    </main>
    <%= include 'footer.html.erb' %>
  </body>
</html>

