<!DOCTYPE html>
<html>
    <head>
        <link rel="stylesheet" href="style.css">
        <title>explain.8-p.info</title>
    </head>
    <body>
        <header>
            <div>Explain</div>
            <div class="ja">説明</div>
        </header>
        <main id="index">
	  <ul class="pages">
            <% Page.find('src/*/*.md').each do |page| %>
	    <li>
	      <a href="<%= page.url %>"><%= page.title %></a>
	      <div class="meta">
		<span>Edited at <%= page.mtime&.strftime('%Y-%m-%d') %></span>
		<span><%= if page.url =~ %r{^ja/} then '日本語' else 'English' end %></span>
	      </div>
	    </li>
	  <% end %>
	  </table>
        </main>
    </body>
</html>

