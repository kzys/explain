<!DOCTYPE html>
<html>
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="<%= asset_path('style.css') %>">
    <link rel="alternate" type="application/atom+xml" href="atom.xml">
    <title>explain / 説明</title>
  </head>
  <body>
    <%= include 'header.html.erb' %>
    <main id="index">
      <% pages = self.find('src/**/*.md').sort{|a, b| b.mtime <=> a.mtime } %>
      <% max_size = pages.map(&:size).max %>
      <% ja_size = pages.select(&:ja?).map(&:size).sum %>
      <% en_size = pages.select(&:en?).map(&:size).sum %>
      <% total_size = ja_size + en_size %>
      <% ja_percent = total_size > 0 ? (ja_size.to_f / total_size * 100).round(1) : 0 %>
      <% en_percent = total_size > 0 ? (en_size.to_f / total_size * 100).round(1) : 0 %>

      <div class="language-ratio">
        <h2>Language Distribution</h2>
        <div class="ratio-bars">
          <div class="ratio-bar ja-bar" style="width:<%= ja_percent %>%">
            <span class="ratio-label">
              <span class="lang-name">日本語</span>
              <span class="lang-percent"><%= ja_percent %>% · <%= human_size(ja_size) %></span>
            </span>
          </div>
          <div class="ratio-bar en-bar" style="width:<%= en_percent %>%">
            <span class="ratio-label">
              <span class="lang-name">English</span>
              <span class="lang-percent"><%= en_percent %>% · <%= human_size(en_size) %></span>
            </span>
          </div>
        </div>
      </div>
      <% grouped = self.group_by_content(pages) %>
      <% grouped.each do |base_path, group_pages| %>
      <article>
	<% if group_pages.length > 1 %>
	  <% group_pages.each do |page| %>
	    <div class="language-section">
	      <a href="<%= page.url %>" class="article-link">
		<h2><% if page.directory %><span class="directory-tag"><%= page.directory %></span> <% end %><%= page.title %></h2>
		<% if page.headlines.any? %>
		  <ul class="headlines">
		    <% page.headlines.each do |headline| %>
		      <li class="headline-level-<%= headline[:level] %>"><%= headline[:text] %></li>
		    <% end %>
		  </ul>
		<% end %>
		<% if page.changes && page.changes.length > 0 %>
		  <div class="page-metadata">
		    <ul class="changes-items">
		      <% reversed = page.changes.reverse.uniq { |t| t.to_date } %>
		      <% reversed.each_with_index do |timestamp, index| %>
			<li>
			  <time datetime="<%= timestamp.strftime('%Y-%m-%d') %>"><%= timestamp.strftime('%Y-%m-%d') %></time><% if index == 0 %> - created<% else %> - updated<% end %>
			</li>
		      <% end %>
		    </ul>
		  </div>
		<% end %>
		<div class="meta">
		  <div class="bar <%= page.bar_class %>" style="width:<%= [(page.size.to_f / max_size * 100).round(1), 1].max %>%"><%= page.language_name %> · <%= page.human_size %></div>
		</div>
	      </a>
	    </div>
	  <% end %>
	<% else %>
	  <a href="<%= group_pages.first.url %>" class="article-link">
	    <h2><% if group_pages.first.directory %><span class="directory-tag"><%= group_pages.first.directory %></span> <% end %><%= group_pages.first.title %></h2>
	    <% page = group_pages.first %>
	    <% if page.headlines.any? %>
	      <ul class="headlines">
		<% page.headlines.each do |headline| %>
		  <li class="headline-level-<%= headline[:level] %>"><%= headline[:text] %></li>
		<% end %>
	      </ul>
	    <% end %>
	    <% if page.changes && page.changes.length > 0 %>
	      <div class="page-metadata">
		<ul class="changes-items">
		  <% reversed = page.changes.reverse.uniq { |t| t.to_date } %>
		  <% reversed.each_with_index do |timestamp, index| %>
		    <li>
		      <time datetime="<%= timestamp.strftime('%Y-%m-%d') %>"><%= timestamp.strftime('%Y-%m-%d') %></time><% if index == 0 %> - created<% else %> - updated<% end %>
		    </li>
		  <% end %>
		</ul>
	      </div>
	    <% end %>
	    <div class="meta">
	      <div class="bar <%= page.bar_class %>" style="width:<%= [(page.size.to_f / max_size * 100).round(1), 1].max %>%"><%= page.language_name %> · <%= page.human_size %></div>
	    </div>
	  </a>
	<% end %>
      </article>
      <% end %>
    </main>
    <%= include 'footer.html.erb' %>
  </body>
</html>
