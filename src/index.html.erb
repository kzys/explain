<!DOCTYPE html>
<html>
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="stylesheet" href="style.css">
        <link rel="alternate" type="application/atom+xml" href="atom.xml">
        <title>explain / 説明</title>
    </head>
    <body>
      <%= include 'header.html.erb' %>
        <main id="index">
	  <ul class="pages">
            <% self.find('src/*/*.md').each do |page| %>
	    <li>
	      <a href="<%= page.url %>"><%= page.title %></a>
	      <div class="meta">
		<span>Edited at <%= page.mtime&.strftime('%Y-%m-%d') %></span>
		<span><%= if page.url =~ %r{^ja/} then '日本語' else 'English' end %></span>
	      </div>
	    </li>
	  <% end %>
	  </table>
        </main>
      <%= include 'footer.html.erb' %>
    </body>
</html>

