<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>explain / 説明</title>
  <link href="<%= @config['site_url'] %>/atom.xml" rel="self"/>
  <link href="<%= @config['site_url'] %>"/>
  <updated><%= Time.now.utc.iso8601 %></updated>
  <id><%= @config['site_url'] %>/</id>
  <author>
    <name>Your Name</name>
  </author>

  <% self.find('src/*/*.md').sort_by(&:mtime).reverse.take(10).each do |page| %>
  <entry>
    <title><%= page.title %></title>
    <link href="<%= @config['site_url'] %>/<%= page.url %>"/>
    <updated><%= page.mtime&.utc&.iso8601 %></updated>
    <id><%= @config['site_url'] %>/<%= page.url %></id>
    <content type="html"><![CDATA[<%= page.content %>]]></content>
  </entry>
  <% end %>
</feed>