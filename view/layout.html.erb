<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="stylesheet" href="<%= site_root(page) %>/<%= asset_path('style.css') %>">
        <link rel="alternate" type="application/atom+xml" href="<%= @config['site_url'] %>/atom.xml" title="explain / 説明">
        <title><%= page.title %></title>
    </head>
    <body>
      <%= include 'header.html.erb' %>
      <main>
        <h1><%= page.title %></h1>
        <% if page.changes && page.changes.length > 0 %>
          <div class="page-metadata">
            <ul class="changes-items">
              <% reversed = page.changes.reverse.uniq { |t| t.to_date } %>
              <% reversed.each_with_index do |timestamp, index| %>
                <li>
                  <time datetime="<%= timestamp.strftime('%Y-%m-%d') %>"><%= timestamp.strftime('%Y-%m-%d') %></time><% if index == 0 %> - created<% else %> - updated<% end %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <%= page.content %>
      </main>
      <%= include 'footer.html.erb', page: page %>
    </body>
</html>
